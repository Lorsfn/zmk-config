#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W           &kp E           &kp R               &kp T  &none  &kp CAPS  &kp Y  &kp U                &kp I            &kp O            &kp P     &kp BSPC
&kp TAB     &kp A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_CONTROL F  &kp G  &none  &none     &kp H  &mt RIGHT_CONTROL J  &mt RIGHT_GUI K  &mt RIGHT_ALT L  &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X           &kp C           &kp V               &kp B                   &kp N  &kp M                &kp COMMA        &kp DOT          &kp FSLH  &kp RIGHT_SHIFT
                                   &kp LGUI        &kp ENTER           &mo 1                   &mo 2  &kp SPACE            &kp RALT
            >;

            sensor-bindings =
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        NUM {
            display-name = "NUM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none  &kp PRINTSCREEN  &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &kp DELETE
&kp LCTRL  &none   &none   &none   &none   &none   &none  &kp K_MUTE       &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none   &none
&kp LSHFT  &none   &none   &none   &none   &none                           &none     &none     &none   &none      &none   &none
                           &trans  &trans  &trans                          &mo 3     &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SYM {
            display-name = "SYM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL           &kp AT            &kp HASH  &kp DLLR  &kp PRCNT  &none  &kp LG(ESCAPE)    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &none              &none             &none     &none     &none      &none  &kp K_PLAY_PAUSE  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &kp LG(LESS_THAN)  &kp GREATER_THAN  &none     &none     &mo 4                               &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                                &trans    &trans    &mo 3                               &mo 2      &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp A A>,
                <&inc_dec_kp C_PREVIOUS C_NEXT>;
        };

        SET {
            display-name = "SET";
            bindings = <
&rgb_ug RGB_COLOR_HSB(264,100,35)  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &none  &kp K_POWER  &none  &none  &none  &none  &none  &none
&bt BT_CLR                         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &none  &none        &none  &none  &none  &none  &none  &none
&none                              &none            &none            &sys_reset       &bootloader      &studio_unlock                       &none  &none  &none  &none  &none  &none
                                                                     &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &none                                &none  &none  &none
            >;
        };

        SPEC {
            display-name = "SPEC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
